{
  "name": "float-community",
  "private": true,
  "version": "0.2.0",
  "description": "Unofficial community documentation, SDK and CLI for Float, the Solana coin launcher built on Raydium LaunchLab.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"scripts/test/**/*.test.ts\"",
    "float": "node packages/cli/src/main.ts",
    "lint:docs": "markdownlint-cli2 \"docs/**/*.md\" \"README.md\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
